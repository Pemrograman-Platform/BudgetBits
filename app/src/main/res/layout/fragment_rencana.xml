<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/space_lg"
    android:background="@color/surface_soft">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Atur Keuangan"
        android:textSize="@dimen/text_h1"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="@dimen/space_md"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tentukan saldo awal dan batas pengeluaran bulananmu."
        android:textColor="@color/text_muted"
        android:layout_marginBottom="@dimen/space_lg"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_md"
        app:boxCornerRadiusTopStart="@dimen/radius_md"
        app:boxCornerRadiusTopEnd="@dimen/radius_md"
        app:boxCornerRadiusBottomStart="@dimen/radius_md"
        app:boxCornerRadiusBottomEnd="@dimen/radius_md"
        app:prefixText="Rp ">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSaldo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Saldo Saat Ini"
            android:inputType="number"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_lg"
        app:boxCornerRadiusTopStart="@dimen/radius_md"
        app:boxCornerRadiusTopEnd="@dimen/radius_md"
        app:boxCornerRadiusBottomStart="@dimen/radius_md"
        app:boxCornerRadiusBottomEnd="@dimen/radius_md"
        app:prefixText="Rp ">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etBudget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Budget Bulanan"
            android:inputType="number"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveRencana"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Simpan Rencana"
        android:padding="14dp"
        app:cornerRadius="@dimen/radius_md"
        app:backgroundTint="@color/brand_primary"/>

</LinearLayout>